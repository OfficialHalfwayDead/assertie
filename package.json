{
  "name": "assertie",
  "version": "0.3.2",
  "description": "Debug assertions for TypeScript, auto tree-shaken by vite for production.",
  "keywords": [
    "TypeScript",
    "vite",
    "debug",
    "assert"
  ],
  "homepage": "https://github.com/OfficialHalfwayDead/assertie#readme",
  "bugs": {
    "url": "https://github.com/OfficialHalfwayDead/assertie/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OfficialHalfwayDead/assertie.git"
  },
  "license": "MIT",
  "author": "halfie",
  "type": "module",
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "exports": {
    "import": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "typescript": ">=4.7.0",
    "vite": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.11",
    "typescript": "4.7.4",
    "vite": "2.0.5"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run test:runtime",
    "test:runtime": "npm run test:runtime:check && vite build --mode development -c test/runtime/vite.config.ts && node .test-build/test.js",
    "test:runtime:check": "tsc -p test/runtime/tsconfig.json"
  }
}
